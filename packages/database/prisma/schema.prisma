  closed_at                                DateTime?                @db.Timestamp(6)
  sla_breach_at                            DateTime?                @db.Timestamp(6)
  csat_score                               Int?
  csat_comment                             String?
  custom_fields                            Json?
  /// Set when the AI assistant escalated this ticket to the human team; the AI stays silent afterwards
  ai_escalated_at                          DateTime?                @db.Timestamp(6)
  /// Where the thread came from: 'ticket' (support form) or 'live_chat' (continuous chat surface)
  source                                   String                   @default("ticket") @db.VarChar(20)
  support_messages                         support_messages[]
  users_support_tickets_assigned_toTousers users?                   @relation("support_tickets_assigned_toTousers", fields: [assigned_to], references: [id], onUpdate: NoAction)
  users_support_tickets_user_idTousers     users                    @relation("support_tickets_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_support_tickets_user_id")
  @@index([assigned_to], map: "idx_support_tickets_assigned_to")
  @@index([status], map: "idx_support_tickets_status")
  @@index([priority], map: "idx_support_tickets_priority")
  @@index([created_at(sort: Desc)], map: "idx_support_tickets_created_at")
}

/// Support messages within tickets
model support_messages {
  id              Int             @id @default(autoincrement())
  ticket_id       Int
  sender_id       Int
  content         String
  type            String?         @default("text") @db.VarChar(50)
  attachment_url  String?
  is_internal     Boolean?        @default(false)
  created_at      DateTime?       @default(now()) @db.Timestamp(6)
  users           users           @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  support_tickets support_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ticket_id], map: "idx_support_messages_ticket_id")
  @@index([sender_id], map: "idx_support_messages_sender_id")
  @@index([created_at(sort: Desc)], map: "idx_support_messages_created_at")
}

/// Per-editor "last seen" timestamp for dashboard notification sections.
/// Used to compute "unread" badge counts: a badge clears when the editor opens
/// the section (last_seen_at bumps to now) and only relights when newer items arrive.
model editor_section_seen {
  editor_id    Int
  section      String   @db.VarChar(50)
  last_seen_at DateTime @default(now()) @db.Timestamp(6)

  @@id([editor_id, section])
  @@index([editor_id], map: "idx_editor_section_seen_editor")
}

/// Verification pricing for individual and business verification
model verification_pricing {
  id                  Int       @id @default(autoincrement())
  verification_type   String    @db.VarChar(20)
  duration_days       Int
  price               Decimal   @db.Decimal(10, 2)
  discount_percentage Int?      @default(0)
  is_active           Boolean?  @default(true)
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  updated_at          DateTime? @default(now()) @db.Timestamp(6)

  @@unique([verification_type, duration_days])
  @@index([verification_type], map: "idx_verification_pricing_type")
}

/// Promotional campaigns for verification discounts
model verification_campaigns {
  id                  Int       @id @default(autoincrement())
  name                String    @db.VarChar(100)
  description         String?
  discount_percentage Int       @default(0)
  promo_code          String?   @db.VarChar(50)
  banner_text         String?   @db.VarChar(255)
  banner_emoji        String?   @default("🎉") @db.VarChar(10)
  start_date          DateTime  @db.Timestamp(6)
  end_date            DateTime  @db.Timestamp(6)
  is_active           Boolean?  @default(true)
  applies_to_types    String[]  // ['individual', 'business']
  min_duration_days   Int?
  max_uses            Int?
  current_uses        Int?      @default(0)
  created_by          Int?
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  updated_at          DateTime? @default(now()) @db.Timestamp(6)
  users               users?    @relation("verification_campaigns_created_by", fields: [created_by], references: [id], onUpdate: NoAction)

  @@index([is_active, start_date, end_date], map: "idx_verif_campaigns_active")
  @@index([promo_code], map: "idx_verif_campaigns_code")
}

model site_settings {
  id            Int       @id @default(autoincrement())
  setting_key   String    @unique @db.VarChar(100)
  setting_value String?
  setting_type  String?   @default("string") @db.VarChar(50)
  description   String?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
}

/// Reusable editor response templates ("macros"). Powers both the editor
/// Response Templates manager and the support-ticket "Insert" quick-reply.
/// visibility: 'global' (all editors) | 'private' (only the creator).
model support_macros {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(100)
  title_ne    String?   @db.VarChar(100)
  content     String
  content_ne  String?
  category    String    @default("support") @db.VarChar(50)
  visibility  String    @default("private") @db.VarChar(20)
  usage_count Int       @default(0)
  is_active   Boolean   @default(true)
  created_by  Int
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  users       users     @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_by], map: "idx_support_macros_created_by")
  @@index([visibility], map: "idx_support_macros_visibility")
}

enum user_role {
  user
  editor
  super_admin
  root
}

/// Support ticket statuses
enum support_ticket_status {
  open
  in_progress
  waiting_on_user
  resolved
  closed
}

/// Support ticket priority levels
enum support_ticket_priority {
  low
  normal
  high
  urgent
}

/// Support ticket categories
enum support_ticket_category {
  general
  account
  payment
  ads
  verification
  technical
  report
  other
}

/// Refresh tokens for long-lived sessions with rotation
model refresh_tokens {
  id          Int      @id @default(autoincrement())
  user_id     Int
  token       String   @unique @db.VarChar(255)
  expires_at  DateTime @db.Timestamp(6)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  is_revoked  Boolean  @default(false)
  replaced_by String?  @db.VarChar(255) // New token that replaced this one (for rotation)
  
  // Relations
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_refresh_tokens_user")
  @@index([token], map: "idx_refresh_tokens_token")
}

// ============================================
// BLOG SYSTEM
// ============================================

/// Blog authors — writer profiles with E-E-A-T credentials
model blog_authors {
  id              Int          @id @default(autoincrement())
  name            String       @db.VarChar(200)
  name_ne         String?      @db.VarChar(200)
  slug            String       @unique @db.VarChar(200)
  avatar          String?      @db.VarChar(500)
  bio             String?
  bio_ne          String?
  credentials     String?      @db.VarChar(500)
  credentials_ne  String?      @db.VarChar(500)
  expertise_areas String[]     @default([])
  social_links    Json?
  is_active       Boolean      @default(true)
  created_at      DateTime?    @default(now()) @db.Timestamp(6)
  updated_at      DateTime?    @default(now()) @updatedAt @db.Timestamp(6)
  blog_posts      blog_posts[]

  @@index([slug], map: "idx_blog_authors_slug")
  @@index([is_active], map: "idx_blog_authors_active")
}

/// Blog categories — separate from marketplace categories, linked via FK
model blog_categories {
  id                      Int               @id @default(autoincrement())
  name                    String            @db.VarChar(200)
  name_ne                 String?           @db.VarChar(200)
  slug                    String            @unique @db.VarChar(200)
  description             String?
  description_ne          String?
  parent_id               Int?
  display_order           Int?              @default(999)
  is_active               Boolean           @default(true)
  marketplace_category_id Int?
  created_at              DateTime?         @default(now()) @db.Timestamp(6)
  blog_categories         blog_categories?  @relation("blogCategoriesToBlogCategories", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_blog_categories   blog_categories[] @relation("blogCategoriesToBlogCategories")
  marketplace_category    categories?       @relation(fields: [marketplace_category_id], references: [id], onUpdate: NoAction)
  blog_posts              blog_posts[]

  @@index([slug], map: "idx_blog_categories_slug")
  @@index([parent_id], map: "idx_blog_categories_parent_id")
  @@index([marketplace_category_id], map: "idx_blog_categories_marketplace")
}

/// Blog tags for SEO
model blog_tags {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(100)
  name_ne        String?          @db.VarChar(100)
  slug           String           @unique @db.VarChar(100)
  created_at     DateTime?        @default(now()) @db.Timestamp(6)
  blog_post_tags blog_post_tags[]

  @@index([slug], map: "idx_blog_tags_slug")
}

/// Blog posts — core content table
model blog_posts {
  id                    Int              @id @default(autoincrement())
  title                 String           @db.VarChar(500)
  title_ne              String?          @db.VarChar(500)
  slug                  String           @unique @db.VarChar(500)
  excerpt               String?          @db.VarChar(1000)
  excerpt_ne            String?          @db.VarChar(1000)
  content               String
  content_ne            String?
  meta_description      String?          @db.VarChar(320)
  meta_description_ne   String?          @db.VarChar(320)
  featured_image        String?          @db.VarChar(500)
  featured_image_alt    String?          @db.VarChar(300)
  featured_image_alt_ne String?          @db.VarChar(300)
  status                String           @default("draft") @db.VarChar(20)
  author_id             Int
  category_id           Int
  reading_time_min      Int?             @default(5)
  view_count            Int              @default(0)
  is_featured           Boolean          @default(false)
  published_at          DateTime?        @db.Timestamp(6)
  created_at            DateTime?        @default(now()) @db.Timestamp(6)
  updated_at            DateTime?        @default(now()) @updatedAt @db.Timestamp(6)
  linked_category_slugs String[]         @default([])
  blog_authors          blog_authors     @relation(fields: [author_id], references: [id], onUpdate: NoAction)
  blog_categories       blog_categories  @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  blog_post_tags        blog_post_tags[]

  @@index([slug], map: "idx_blog_posts_slug")
  @@index([status, published_at(sort: Desc)], map: "idx_blog_posts_status_published")
  @@index([author_id], map: "idx_blog_posts_author")
  @@index([category_id], map: "idx_blog_posts_category")
  @@index([is_featured], map: "idx_blog_posts_featured")
}

/// Blog post tags — many-to-many junction
model blog_post_tags {
  id         Int        @id @default(autoincrement())
  post_id    Int
  tag_id     Int
  blog_posts blog_posts @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  blog_tags  blog_tags  @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([post_id, tag_id])
  @@index([post_id], map: "idx_blog_post_tags_post")
  @@index([tag_id], map: "idx_blog_post_tags_tag")
}

/// Append-only ledger of every purchase and every badge grant. Written ONLY by
/// database triggers (see migration 20260902000000_purchase_history_ledger) so
/// the record survives ad and account deletion; user_id / ad_id /
/// payment_transaction_id are plain integers with NO relations on purpose.
/// Also carries a CHECK constraint Prisma cannot model.
model purchase_history {
  id                     Int       @id @default(autoincrement())
  event                  String    @db.VarChar(16)
  kind                   String    @db.VarChar(32)
  user_id                Int
  user_name              String?   @db.VarChar(255)
  user_phone             String?   @db.VarChar(20)
  user_email             String?   @db.VarChar(255)
  shop_slug              String?   @db.VarChar(255)
  ad_id                  Int?
  ad_title               String?   @db.VarChar(255)
  promotion_type         String?   @db.VarChar(20)
  duration_days          Int?
  label                  String?   @db.VarChar(255)
  amount                 Decimal   @default(0) @db.Decimal(10, 2)
  payment_status         String    @default("free") @db.VarChar(20)
  payment_gateway        String?   @db.VarChar(20)
  payment_method         String?   @db.VarChar(50)
  payment_transaction_id Int?
  occurred_at            DateTime  @db.Timestamp(6)
  expires_at             DateTime? @db.Timestamp(6)
  source_table           String    @db.VarChar(40)
  source_id              Int
  created_at             DateTime  @default(now()) @db.Timestamp(6)

  @@unique([source_table, source_id, event, occurred_at], map: "purchase_history_source_unique")
  @@index([user_id], map: "idx_purchase_history_user_id")
  @@index([occurred_at(sort: Desc)], map: "idx_purchase_history_occurred_at")
  @@index([kind, event], map: "idx_purchase_history_kind_event")
  @@index([payment_transaction_id], map: "idx_purchase_history_payment_txn")
}
