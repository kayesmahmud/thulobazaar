generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ad_images {
  id            Int       @id @default(autoincrement())
  ad_id         Int
  filename      String    @db.VarChar(255)
  original_name String    @db.VarChar(255)
  file_path     String    @db.VarChar(500)
  file_size     Int?
  mime_type     String?   @db.VarChar(100)
  is_primary    Boolean?  @default(false)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  ads           ads       @relation(fields: [ad_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ad_id], map: "idx_ad_images_ad_id")
  @@index([created_at], map: "idx_ad_images_created_at")
  @@index([ad_id, is_primary], map: "idx_ad_images_primary")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model ad_promotions {
  id                Int       @id @default(autoincrement())
  ad_id             Int
  user_id           Int
  promoted_by       Int?
  promotion_type    String    @db.VarChar(20)
  duration_days     Int
  price_paid        Decimal   @db.Decimal(10, 2)
  account_type      String    @db.VarChar(20)
  payment_reference String?   @db.VarChar(255)
  payment_method    String?   @db.VarChar(50)
  starts_at         DateTime? @default(now()) @db.Timestamp(6)
  expires_at        DateTime  @db.Timestamp(6)
  is_active         Boolean?  @default(true)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  ads               ads       @relation(fields: [ad_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ad_id], map: "idx_ad_promotions_ad_id")
  @@index([expires_at], map: "idx_ad_promotions_expires_at")
  @@index([user_id], map: "idx_ad_promotions_user_id")
  @@index([promoted_by], map: "idx_ad_promotions_promoted_by")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ad_reports {
  id          Int       @id @default(autoincrement())
  ad_id       Int
  reporter_id Int
  reason      String    @db.VarChar(100)
  details     String?
  status      String?   @default("pending") @db.VarChar(20)
  admin_notes String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  ads         ads       @relation(fields: [ad_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users     @relation(fields: [reporter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([ad_id, reporter_id], map: "idx_ad_reports_unique")
  @@unique([ad_id, reporter_id], map: "idx_unique_ad_report")
  @@index([ad_id], map: "idx_ad_reports_ad_id")
  @@index([created_at(sort: Desc)], map: "idx_ad_reports_created_at")
  @@index([reporter_id], map: "idx_ad_reports_reporter_id")
  @@index([status], map: "idx_ad_reports_status")
}

/// Ad review history - tracks all status changes for ads
model ad_review_history {
  id         Int       @id @default(autoincrement())
  ad_id      Int
  action     String    @db.VarChar(50)
  actor_id   Int
  actor_type String    @db.VarChar(20)
  reason     String?
  notes      String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  ads        ads       @relation(fields: [ad_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ad_review_history_ad")
  users      users     @relation(fields: [actor_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ad_review_history_user")

  @@index([ad_id], map: "idx_ad_review_history_ad_id")
  @@index([created_at(sort: Desc)], map: "idx_ad_review_history_created_at")
  @@index([action], map: "idx_ad_review_history_action")
}

/// Ad edit history - snapshot of the ad before each owner edit (Facebook-style version history)
model ad_edit_history {
  id               Int       @id @default(autoincrement())
  ad_id            Int
  edited_by        Int
  /// Ad content BEFORE this edit: title, description, price, category_id, location_id, condition, custom_fields, image paths
  previous_data    Json
  /// Status the ad ended up in after this edit: 'pending' (re-review) or 'approved' (trusted live edit)
  resulting_status String    @db.VarChar(20)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  ads              ads       @relation(fields: [ad_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ad_edit_history_ad")
  users            users     @relation(fields: [edited_by], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ad_edit_history_user")

  @@index([ad_id], map: "idx_ad_edit_history_ad_id")
  @@index([created_at(sort: Desc)], map: "idx_ad_edit_history_created_at")
  @@index([resulting_status], map: "idx_ad_edit_history_resulting_status")
}

/// Phone OTPs - for phone number verification
model phone_otps {
  id         Int      @id @default(autoincrement())
  phone      String   @db.VarChar(20)
  otp_code   String   @db.VarChar(6)
  purpose    String   @default("registration") @db.VarChar(50)
  attempts   Int      @default(0)
  is_used    Boolean  @default(false)
  expires_at DateTime @db.Timestamp(6)
  created_at DateTime @default(now()) @db.Timestamp(6)

  @@index([phone], map: "idx_phone_otps_phone")
  @@index([phone, otp_code], map: "idx_phone_otps_phone_code")
  @@index([expires_at], map: "idx_phone_otps_expires")
}

/// Shop reports - for reporting shops/sellers
model shop_reports {
  id          Int       @id @default(autoincrement())
  shop_id     Int
  reporter_id Int
  reason      String    @db.VarChar(100)
  details     String?
  status      String?   @default("pending") @db.VarChar(20)
  admin_notes String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  resolved_by Int?
  reporter    users     @relation("shop_reports_reporter", fields: [reporter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  resolver    users?    @relation("shop_reports_resolver", fields: [resolved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shop        users     @relation("shop_reports_shop", fields: [shop_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([shop_id, reporter_id], map: "idx_shop_reports_unique")
  @@index([shop_id], map: "idx_shop_reports_shop_id")
  @@index([created_at(sort: Desc)], map: "idx_shop_reports_created_at")
  @@index([reporter_id], map: "idx_shop_reports_reporter_id")
  @@index([status], map: "idx_shop_reports_status")
}

/// Blocked users - bidirectional messaging block (blocker can no longer message or be messaged by blocked)
model blocked_users {
  id         Int       @id @default(autoincrement())
  blocker_id Int
  blocked_id Int
  created_at DateTime? @default(now()) @db.Timestamp(6)
  blocker    users     @relation("blocked_users_blocker", fields: [blocker_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  blocked    users     @relation("blocked_users_blocked", fields: [blocked_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([blocker_id, blocked_id], map: "idx_blocked_users_unique")
  @@index([blocker_id], map: "idx_blocked_users_blocker_id")
  @@index([blocked_id], map: "idx_blocked_users_blocked_id")
}

/// User reports - for reporting users from chat conversations
model user_reports {
  id               Int       @id @default(autoincrement())
  reported_user_id Int
  reporter_id      Int
  reason           String    @db.VarChar(100)
  details          String?
  status           String?   @default("pending") @db.VarChar(20)
  admin_notes      String?
  conversation_id  Int?
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  resolved_by      Int?
  reporter         users     @relation("user_reports_reporter", fields: [reporter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reported         users     @relation("user_reports_reported", fields: [reported_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  resolver         users?    @relation("user_reports_resolver", fields: [resolved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([reported_user_id, reporter_id], map: "idx_user_reports_unique")
  @@index([reported_user_id], map: "idx_user_reports_reported_user_id")
  @@index([reporter_id], map: "idx_user_reports_reporter_id")
  @@index([status], map: "idx_user_reports_status")
  @@index([created_at(sort: Desc)], map: "idx_user_reports_created_at")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model admin_activity_logs {
  id          Int       @id @default(autoincrement())
